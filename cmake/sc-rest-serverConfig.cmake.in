@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/SimplyCppFunctions.cmake")

set_and_check(SC_TEST_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

find_or_install_package(sc-core simply-cpp-dev simply-cpp 1.4.3)
include("${CMAKE_CURRENT_LIST_DIR}/oatpp.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/sc-rest-serverTargets.cmake")
target_link_libraries(sc::sc-rest-server INTERFACE oatpp)
target_link_libraries(sc::sc-rest-server-shared INTERFACE oatpp)
