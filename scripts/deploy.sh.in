#!/bin/bash
#~~~~~~~~~~
# Generated by cmake from simply-cpp's scripts/deploy.sh.in.
# Edit the template, not this copy: sc_bootstrap.cmake reports when this file has
# drifted, and -DSC_UPDATE_HELPERS=ON puts it back.
#
# Usage: scripts/deploy.sh [server] [user]

module="sc-@SC_DEPLOY_NAME@"
server="${1:-build}"
user="${2:-root}"
scriptfile=$(realpath "$0")
scriptpath="${scriptfile%/*}"
dirpath=$(realpath "$scriptpath"/..)
pushd "$dirpath" || exit
echo "Running cmake to make sure scripted files are up to date."
cmake -DCMAKE_BUILD_TYPE=Release -B cmake-build-local -S . || exit
echo "Syncing $dirpath to $server:$module"
rsync -av ./ "$user@$server:/var/www/build/$module/" --exclude=".git" --exclude=".idea" --exclude="cmake-*" --delete || exit
ssh "$user@$server" "/var/www/build/$module/scripts/run.sh"
remote_result=$?
popd || exit
exit $remote_result
